APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/self_evolution.db
CHROMA_PATH=./data/chroma

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ALLOWED_OPEN_ID=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_EVENT_TRANSPORT=long_connection

CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

VISION_BASE_URL=http://vision:8001
VISION_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
VISION_MODEL_VERSION=qwen2.5-vl-3b-4bit-v1
VISION_MAX_IMAGE_BYTES=10485760

WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=5
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_BYTES=2097152
KNOWLEDGE_TOP_K=5
